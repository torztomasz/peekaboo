{
  "manifest_version": 3,
  "name": "Peekaboo: Before/After for GitHub PRs",
  "version": "1.2.0",
  "description": "Flip or pixel-diff the Before/After screenshots in GitHub pull requests and issues, with a full-screen review mode.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Peekaboo: open a GitHub PR with a Before | After screenshot table"
  },
  "homepage_url": "https://github.com/torztomasz/peekaboo",
  "short_name": "Peekaboo"
}
