{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["chrome", "node"],
    "strict": true,
    // esbuild reads this file too: without it every shipped bundle would gain "use strict".
    "alwaysStrict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "bench/blank.ts"]
}
