{
  "name": "peekaboo",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts src/background.ts src/options.ts --bundle --format=iife --target=chrome120 --outdir=dist",
    "watch": "npm run build -- --watch",
    "package": "sh scripts/package.sh",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run test:speed",
    "typecheck": "tsc -p .",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/browser/*.test.mjs",
    "test:speed": "node --test test/speed/*.test.mjs",
    "canary": "node --test test/canary/*.test.mjs",
    "mutate": "node scripts/mutate.mjs",
    "bench": "node bench/background.mjs && node bench/content.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
